# GEMINI_API_KEY: Optional (Manual External Gemini workflow requires zero API key).
# Only needed if using automated backend Gemini calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FISH_API_KEY: Optional server fallback for Fish Audio ASR and TTS dubbing.
# Users can also save an encrypted API key directly from the Settings page.
FISH_API_KEY="MY_FISH_API_KEY"

# SECRETS_ENCRYPTION_KEY: Recommended master secret (8+ chars) for encrypting API keys stored in the backend database.
SECRETS_ENCRYPTION_KEY=""

# SUPABASE FREE PLAN (100% Free Tier — PostgreSQL, Auth, Storage 1GB, Realtime):
# Optional here because users can also connect their free Supabase project directly in Settings.
# Use ONLY your public anon key; never embed service_role secrets in client code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# APP_URL: The URL where this applet or backend is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend API base URL when deploying frontend to Cloudflare Pages.
# Set this to your deployed Express backend URL (e.g., https://my-backend-app.run.app).
VITE_API_BASE_URL=""

# BACKEND_URL: Used by Cloudflare Pages Functions to proxy /api/* to the Express backend.
BACKEND_URL=""

# STORAGE_DIR: Local filesystem directory for uploaded videos, logos, audio, and exports.
STORAGE_DIR="./storage"

# MAX_UPLOAD_SIZE_MB: Maximum local video upload size in MB (default 2048 MB).
MAX_UPLOAD_SIZE_MB="2048"

# TEMP_RETENTION_HOURS: Auto-cleanup threshold for temporary processing files.
TEMP_RETENTION_HOURS="24"
